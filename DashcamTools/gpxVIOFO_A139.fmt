#------------------------------------------------------------------------------
# File:            gpxVIOFO_A139.fmt
#
# newDescription:  Example ExifTool changed to one line and made similar to Dashcam Viewer export
#                  customized to viofo A139 output, Knots translated to m/s
#
# Usage:           exiftool -p gpx.fmt -ee3 FILE [...] > out.gpx
#
# Requires:        ExifTool version 10.49 or later
#
# Notes:           1) Input file(s) must contain GPSLatitude and GPSLongitude.
#                  2) The -ee3 option is to extract the full track from video files.
#                  3) The -fileOrder option may be used to control the order of the
#                     generated track points when processing multiple files.
#------------------------------------------------------------------------------
#[HEAD]<?xml version="1.1" encoding="utf-8" standalone="yes"?>
#[HEAD]<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="ExifTool $ExifToolVersion">
#[HEAD]  <trk>
#[HEAD]    <trkseg>
#[IF]  $gpslatitude $gpslongitude
#[BODY]      <trkpt lat="${gpslatitude#;$_=sprintf('%.8f',$_)}" lon="${gpslongitude#;$_=sprintf('%.8f',$_)}"><time>${gpsdatetime#;my ($ss)=/\.\d+/g;DateFmt("%Y-%m-%dT%H:%M:%SZ");s/Z/${ss}Z/ if $ss}</time><speed>${gpsspeed#;$_=sprintf('%.4f', $_ / 1.94384)}</speed><course>${gpstrack#;$_=sprintf('%.2f',$_)}</course></trkpt>
#[TAIL]    </trkseg>
#[TAIL]  </trk>
#[TAIL]</gpx>